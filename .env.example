# The Odds API (https://the-odds-api.com) -- free tier is 500 credits/month
# This is the only API key you need -- results history now comes from
# ESPN's public API (no key required, see data/espn.py).
ODDS_API_KEY=

# Bankroll / staking defaults (can also be changed in the dashboard Settings tab)
BANKROLL_AMOUNT=1000
UNIT_SIZE_PCT=0.01
MAX_UNITS_PER_BET=3
MIN_EDGE_PCT=0.0075

# Stake size by edge tier -- a fixed unit count per tier (see models/edge.py
# tier_label), capped by MAX_UNITS_PER_BET.
TIER_UNITS_STRONG=2.5
TIER_UNITS_MODERATE=1.75
TIER_UNITS_LEAN=1.0
